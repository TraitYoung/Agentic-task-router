# ===== LLM：Moonshot Kimi 2.6（OpenAI 兼容）=====
# Key: https://platform.moonshot.cn/
LLM_API_KEY=your_moonshot_api_key
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.6
LLM_STRUCTURED_MODE=json_prompt
LLM_REQUEST_TIMEOUT=300
LLM_MAX_TOKENS=8192
# 默认保持官方思考模式；提速可设 LLM_THINKING=disabled

# ===== 可选：步骤级模型（不填则用 LLM_MODEL）=====
LLM_DISCOVERY_MODEL=kimi-k2.6
LLM_SPRINT_MODEL=kimi-k2.6
LLM_IMPLEMENTATION_MODEL=kimi-k2.6
LLM_DELIVERY_MODEL=kimi-k2.6
LLM_MERGE_MODEL=kimi-k2.6

# ===== 兼容旧部署（LLM_* 优先）=====
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=

# ===== 后端 CORS（逗号分隔，供调试直连 API）=====
# CORS_ORIGINS=https://your-preview.vercel.app

# ===== 会话缓存 =====
REDIS_URL=redis://localhost:6379/0

# ===== Frontend（Vercel 仅配此项，LLM Key 放在 HF Space）=====
BACKEND_URL=https://ishowrelx5-specforge-api.hf.space

# ===== 上下文预算（可选） =====
AX_WORKFLOW_USER_MAX_CHARS=8000
AX_WORKFLOW_STEP_JSON_MAX_CHARS=2500
