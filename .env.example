# ===== LLM：DeepSeek V4（OpenAI 兼容，1M 上下文）=====
# Key: https://platform.deepseek.com/
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_STRUCTURED_MODE=native
LLM_THINKING=enabled
LLM_REASONING_EFFORT=max
LLM_REQUEST_TIMEOUT=300
LLM_MAX_TOKENS=8192

# 轻量步骤（test_code / merge 流式文本）→ Flash
LLM_TEST_CODE_MODEL=deepseek-v4-flash
LLM_MERGE_MODEL=deepseek-v4-flash

# 核心 structured 步骤 → Pro
LLM_DISCOVERY_MODEL=deepseek-v4-pro
LLM_SPRINT_MODEL=deepseek-v4-pro
LLM_IMPLEMENTATION_MODEL=deepseek-v4-pro
LLM_DELIVERY_MODEL=deepseek-v4-pro

# 结构化步骤若需单独关思考：LLM_STRUCTURED_THINKING=disabled

# ===== 兼容旧部署（LLM_* 优先）=====
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=

# ===== 后端 CORS（逗号分隔，供调试直连 API）=====
# CORS_ORIGINS=https://your-preview.vercel.app

# ===== 会话缓存 =====
REDIS_URL=redis://localhost:6379/0

# ===== Frontend（Vercel 仅配此项，LLM Key 放在 HF Space）=====
BACKEND_URL=https://ishowrelx5-specforge-api.hf.space

# ===== 上下文预算（可选） =====
AX_WORKFLOW_USER_MAX_CHARS=8000
AX_WORKFLOW_STEP_JSON_MAX_CHARS=2500
