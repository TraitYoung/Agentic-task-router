# ===== 必需：千问兼容配置 =====
# Docker 部署: api 容器读取此文件, frontend 容器通过 BACKEND_URL=http://api:8000 连接
QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ===== 可选：步骤级模型路由 =====
# 不填则回退到 QWEN_MODEL / AX_LLM_DEFAULT_MODEL
AX_LLM_API_KEY=
AX_LLM_BASE_URL=
AX_LLM_DEFAULT_MODEL=qwen-plus
AX_LLM_DISCOVERY_MODEL=qwen-plus
AX_LLM_SPRINT_MODEL=qwen-plus
AX_LLM_IMPLEMENTATION_MODEL=qwen-plus
AX_LLM_DELIVERY_MODEL=qwen-plus
AX_LLM_MERGE_MODEL=qwen-plus

# ===== 会话缓存 =====
# Docker 部署: 无需修改, compose 自动注入 redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ===== Frontend deployment =====
# Vercel production should point to the Render backend URL.
BACKEND_URL=https://specforge-api.onrender.com

# ===== 上下文预算（可选） =====
AX_WORKFLOW_USER_MAX_CHARS=8000
AX_WORKFLOW_STEP_JSON_MAX_CHARS=2500
