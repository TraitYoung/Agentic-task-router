# ===== LLM：Moonshot Kimi 2.6（OpenAI 兼容）=====
# Key: https://platform.moonshot.cn/  海外 Base URL 可用 https://api.moonshot.ai/v1
LLM_API_KEY=your_moonshot_api_key
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.6

# ===== 可选：步骤级模型（不填则用 LLM_MODEL）=====
LLM_DISCOVERY_MODEL=kimi-k2.6
LLM_SPRINT_MODEL=kimi-k2.6
LLM_IMPLEMENTATION_MODEL=kimi-k2.6
LLM_DELIVERY_MODEL=kimi-k2.6
LLM_MERGE_MODEL=kimi-k2.6

# ===== 兼容旧部署（可不填；若与 LLM_* 同时存在，LLM_* 优先）=====
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=
# AX_LLM_API_KEY=
# AX_LLM_DEFAULT_MODEL=

# ===== 会话缓存 =====
REDIS_URL=redis://localhost:6379/0

# ===== Frontend =====
BACKEND_URL=https://ishowrelx5-specforge-api.hf.space

# ===== 上下文预算（可选） =====
AX_WORKFLOW_USER_MAX_CHARS=8000
AX_WORKFLOW_STEP_JSON_MAX_CHARS=2500
